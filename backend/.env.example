# Regula backend configuration (copy to backend/.env.local or export).
# Every variable is optional: omitting all of them reproduces the defaults
# documented below.

# --- LLM provider (Live mode) -------------------------------------------------

# API key for the LLM provider. Live mode needs it: a Live-mode request
# without a configured key answers with a Not-available response naming this
# variable (Demo mode is keyless). Put the real key in backend/.env.local
# (gitignored) or export it — never commit it.
OPENROUTER_API_KEY=

# The chat model every completion asks for. Default: Solar Pro 4 via OpenRouter
# (a suggestion, not a requirement — any model the provider serves works).
LLM_MODEL=upstage/solar-pro4

# OpenAI-compatible base URL, ending at the version root: the client appends
# /chat/completions itself. OpenRouter is the tested path; other
# OpenAI-compatible endpoints (OpenAI, Groq, Together, vLLM, LM Studio,
# Ollama's OpenAI endpoint) are expected to work but untested.
LLM_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter provider routing preference: the provider slug OpenRouter tries
# first for every completion, keeping its usual fallbacks for when that
# provider is unavailable. Default: DeepInfra — the most reliable provider
# serving the current model (OpenRouter's price-based default picked GMICloud,
# which dropped completions mid-generation twice in one eval run). Leave empty
# to load-balance across all providers, and empty too when LLM_BASE_URL points
# somewhere other than OpenRouter (the preference is an OpenRouter feature).
LLM_PROVIDER=deepinfra

# The embedding model used at ingest and query time. Changing it requires
# re-ingesting the Corpus afterwards — embeddings only match queries made with
# the same model (see README, "Live mode setup"):
#   docker compose exec backend python -m backend.src.ingest
EMBEDDING_MODEL=hf.co/nomic-ai/nomic-embed-text-v1.5-GGUF:F16

# --- Local stack --------------------------------------------------------------

# PostgreSQL (pgvector) connection URL — where ingestion writes Chunks and the
# Live-mode retriever reads them.
DATABASE_URL=postgresql://regula:regula@localhost:5432/regula

# Ollama base URL for query-time embeddings.
OLLAMA_API_URL=http://localhost:11434

# --- Server default mode ------------------------------------------------------

# The server-side default mode (demo | live) for analysis requests that omit
# `mode` (ADR-0008: mode is a per-run choice carried on each request; Demo is
# the default). Demo is keyless and deterministic; Live mode additionally
# needs OPENROUTER_API_KEY, an ingested Corpus, and the embedding model.
# REGULA_MODE=demo
